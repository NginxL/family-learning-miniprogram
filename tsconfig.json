{
  "compilerOptions": {
    "target": "ES2019",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node", "miniprogram-api-typings"],
    "rootDirs": ["src/shared", "src/cloud/learning", "src/miniprogram/lib/learning"],
    "paths": {
      "wx-server-sdk": ["./cloudfunctions/familyApi/node_modules/wx-server-sdk"]
    }
  },
  "include": ["src/**/*.ts", "tests/types/**/*.ts"]
}
