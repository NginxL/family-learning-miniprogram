<view class="page">
  <view class="eyebrow">提前看看，明天学什么</view><view class="title">明日计划</view>
  <view class="row"><view class="subtitle">{{date}}</view><button class="quiet" bindtap="refresh">{{mode === 'demo' ? '本机保存' : syncLabel}} ↻</button></view>
  <view wx:if="{{mode === 'demo'}}" class="notice">本机演示 · 尚未连接家庭云数据</view>
  <view wx:if="{{syncError}}" class="notice">{{syncError}}。当前为已保存的预览，联网刷新后更新。</view>
  <block wx:if="{{family}}">
    <view class="tab-row"><view wx:for="{{children}}" wx:key="id" class="chip {{childId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectChild">{{item.name}}</view></view>
    <view wx:if="{{editor !== 'auto' || isChild}}" class="tab-row subjects"><view wx:for="{{subjectOptions}}" wx:key="id" class="subject-chip {{subjectFilter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectSubject">{{item.label}}</view></view>
    <view wx:if="{{!isChild}}" class="segmented"><view class="segment {{editor === 'preview' ? 'selected' : ''}}" data-id="preview" bindtap="changeEditor">明日内容</view><view class="segment {{editor === 'auto' ? 'selected' : ''}}" data-id="auto" bindtap="changeEditor">任务模板</view><view class="segment {{editor === 'manual' ? 'selected' : ''}}" data-id="manual" bindtap="changeEditor">家长添加</view></view>
    <block wx:if="{{editor === 'preview' || isChild}}">
      <view class="card template-overview"><view class="muted">正在使用的每日模板</view><view class="row"><view class="rule-title grow">{{activeTemplateName}}</view><button wx:if="{{!isChild}}" class="quiet" bindtap="openTemplate">修改模板 →</button></view><view class="muted">{{activeTemplateSummary}}</view></view>
      <view class="subtitle">共 {{tasks.length}} 项 · 约 {{minutes}} 分钟</view>
      <view wx:for="{{groups}}" wx:key="id" class="card plan-preview-group">
        <view class="plan-preview-heading" data-id="{{item.id}}" bindtap="togglePreview"><view class="row"><view class="rule-title">{{item.label}}</view><view class="pill {{item.subject}}">{{item.quantityLabel}}</view></view><view class="subtitle">{{item.modeSummary}}</view><view class="muted">{{item.preview}}</view><view class="plan-expand">{{expandedKind === item.id ? '收起 ↑' : '点击查看内容 ↓'}}</view></view>
        <block wx:if="{{expandedKind === item.id}}">
          <view wx:for="{{item.items}}" wx:for-item="task" wx:key="id" class="plan-preview-item"><view class="task-title">{{task.title}}</view><view wx:if="{{task.poetryByline}}" class="muted poetry-byline">{{task.poetryByline}}</view><view class="body"><text selectable="true">{{task.displayDetail || task.detail}}</text></view><view wx:if="{{task.dynastyNote}}" class="muted">{{task.dynastyNote}}</view><button wx:if="{{!isChild && !task.done}}" class="secondary plan-edit-button" data-id="{{task.id}}" bindtap="editTask" disabled="{{busy}}">修改日期 / 删除</button></view>
          <button wx:if="{{item.items.length < item.count}}" class="secondary" bindtap="showMorePreview">再看 20 项 · 已展示 {{item.items.length}} / {{item.count}}</button>
        </block>
      </view>
      <view wx:for="{{dayWarnings}}" wx:key="kind" class="notice">{{item.message}}</view>
      <view wx:if="{{!groups.length}}" class="card empty">{{previewReady ? '明天还没有学习安排' : '正在读取明日安排…'}}</view>
      <button wx:if="{{!isChild}}" class="primary" bindtap="openLibrary">从知识库添加内容</button>
      <view class="muted plan-help">同一孩子同一天的相同内容只安排一次；新学和普通添加过滤已学内容。主动复习及每天固定的安排保留。展开任务可改期或删除，不影响已完成记录。</view>
      <view class="muted plan-help">自动内容随今日学习更新，明天首次打开时确定。删除或改期只调整这一次，自动任务不会在当天补回。</view>
      <button class="quiet" bindtap="openToday">去今日学习 →</button>
    </block>
    <block wx:elif="{{editor === 'auto'}}">
      <view class="card template-editor">
        <view class="row"><view class="rule-title">{{children[childIndex].name}}的任务模板</view><button class="quiet" bindtap="createTemplate" disabled="{{busy}}">＋ 新建</button></view>
        <picker range="{{templates}}" range-key="label" value="{{templateIndex}}" bindchange="selectTemplate" disabled="{{busy || draftDirty}}"><view class="picker">{{newTemplateDraft ? '正在新建模板' : templates[templateIndex].label}} ▾</view></picker>
        <label class="label">模板名称</label><input value="{{templateName}}" bindinput="changeTemplateName" maxlength="24" placeholder="例如：日常积累、周末练习" disabled="{{busy}}" />
        <view class="muted template-caption">每个孩子启用一个模板，后续每天自动使用，无需重复设置。</view>
        <view wx:if="{{!newTemplateDraft && templateId !== activeTemplateId}}" class="template-actions"><button class="secondary" bindtap="activateTemplate" disabled="{{busy || draftDirty || templateConflict}}">启用此模板</button><button class="quiet" bindtap="deleteTemplate" disabled="{{busy || draftDirty || templateConflict}}">删除模板</button></view>
      </view>
      <view wx:if="{{templateConflict}}" class="notice">家人已更新模板，你的草稿已保留。请重新载入最新配置后再修改。<button class="quiet" bindtap="resetRules" disabled="{{busy}}">放弃草稿并重新载入</button></view>
      <view class="subtitle">模板每天 {{dailyCount}} 项 · 数量设为 0 即暂停该类型</view>
      <view wx:for="{{visibleRules}}" wx:key="id" class="card rule-card">
        <view class="row"><view><view class="rule-title">{{item.label}}</view><view class="muted">内容库 {{item.poolCount}} 项</view></view><picker range="{{modes}}" value="{{item.mode === 'review' ? 1 : 0}}" data-id="{{item.id}}" bindchange="changeMode"><view class="mode-picker">{{item.mode === 'review' ? '复习' : '全新'}} ▾</view></picker></view>
        <picker range="{{item.scopes}}" range-key="label" value="{{item.scopeIndex}}" data-id="{{item.id}}" bindchange="changeScope"><view class="picker" style="margin-top:18rpx">{{item.scopes[item.scopeIndex].label}} ▾</view></picker>
        <view class="row" style="margin-top:24rpx"><view class="muted">每天 · {{item.unit}}（0–{{item.max}}）</view><view class="stepper"><button class="step" data-id="{{item.id}}" data-step="-1" bindtap="stepQuantity">−</button><input class="quantity" type="number" maxlength="2" value="{{item.quantity}}" data-id="{{item.id}}" bindinput="changeQuantity" /><button class="step" data-id="{{item.id}}" data-step="1" bindtap="stepQuantity">＋</button></view></view>
        <button class="quiet" data-id="{{item.id}}" bindtap="browseRule">看看这些内容 →</button>
        <view wx:if="{{item.id === 'english-reading' && !item.poolCount}}" class="muted plan-help">可在「家长添加」中选择英文阅读，再加入自动内容库。</view>
      </view>
      <view wx:if="{{!visibleRules.length}}" class="card empty">先在「家长添加」中补充这一类内容库。</view>
      <view class="muted plan-help">全新过滤已学和曾经安排过的内容；复习从已学内容中选择。修改使用中的模板或启用其他模板后，明日预览更新，今日已生成的任务和完成记录保留。内容不足时提示缺额。</view>
      <button class="primary" bindtap="saveTemplate" loading="{{busy}}" disabled="{{busy || templateConflict}}">{{templateId === activeTemplateId ? '保存模板 · 后续自动使用' : '保存模板'}}</button>
      <button wx:if="{{templateId !== activeTemplateId}}" class="secondary template-use" bindtap="saveAndUseTemplate" disabled="{{busy || templateConflict}}">保存并启用</button>
      <view class="row" style="margin-top:18rpx"><button wx:if="{{draftDirty}}" class="quiet" bindtap="resetRules" disabled="{{busy}}">放弃未保存修改</button><button class="quiet" bindtap="openToday">查看今日任务 →</button></view>
      <view class="muted plan-help">默认亲子入门，可扩大到课标范围。课标学段不是上海五四制年级；校内教材全量仍在核对。家长加入的内容库也会参与安排。</view>
    </block>
    <block wx:else>
      <view class="card"><form bindsubmit="addPlan">
        <view class="rule-title">为 {{children[childIndex].name}} 添加内容</view>
        <label class="label">学习类型</label><picker range="{{kinds}}" range-key="label" value="{{kindIndex}}" bindchange="changeKind"><view class="picker">{{kinds[kindIndex].label}} ▾</view></picker>
        <label class="label">怎样安排</label><picker range="{{schedules}}" value="{{scheduleIndex}}" bindchange="changeSchedule"><view class="picker">{{schedules[scheduleIndex]}} ▾</view></picker>
        <block wx:if="{{scheduleIndex !== 2}}"><label class="label">{{scheduleIndex === 1 ? '开始日期' : '学习日期'}}</label><picker mode="date" value="{{planDate}}" start="{{today}}" end="{{maxPlanDate}}" bindchange="changePlanDate"><view class="picker">{{planDate}}{{planDate === date ? ' · 明日' : planDate === today ? ' · 今日' : ''}} ▾</view></picker></block>
        <view wx:if="{{scheduleIndex === 2}}" class="muted" style="margin-top:10rpx">保存到内容库，按上方自动安排的数量选取；一条内容计一项。</view>
        <label class="label">名称</label><input name="title" value="{{formTitle}}" maxlength="60" placeholder="例如：apple ／《小池》／绘本第 1–3 页" />
        <label class="label">正文或学习提示</label><textarea name="detail" value="{{formDetail}}" maxlength="2000" placeholder="单词释义、诗文正文、句子，或读书页码和问题" auto-height />
        <label class="label">预计分钟数</label><input name="minutes" value="{{formMinutes}}" type="number" maxlength="3" placeholder="5" />
        <label class="label">内容年级（家长标注，选填）</label><picker range="{{gradeLabels}}" value="{{studyGrade}}" bindchange="changeStudyGrade"><view class="picker">{{gradeLabels[studyGrade]}} ▾</view></picker><view class="muted">依据孩子的课本填写；会与教材已核实的进度分别展示。</view>
        <button class="primary" form-type="submit" loading="{{busy}}" disabled="{{busy}}">{{scheduleIndex === 2 ? '加入内容库' : '添加学习安排'}}</button>
      </form></view>
      <view class="section">家长添加的内容</view>
      <view wx:for="{{plans}}" wx:key="id" class="card"><view class="row"><view class="grow"><view class="pill {{item.subject}}">{{item.kindLabel}} · {{item.scheduleLabel}}</view><view class="task-title">{{item.title}}</view></view><switch checked="{{item.enabled}}" disabled="{{busy}}" color="#27654c" data-id="{{item.id}}" bindchange="togglePlan" /></view></view>
      <view wx:if="{{!plans.length}}" class="muted">还没有手动添加的内容。</view>
      <view class="muted plan-help">暂停只影响后续安排，已生成的任务和学习记录会保留。</view>
    </block>
  </block>
  <view wx:else class="card empty"><view>{{syncError ? '学习档案暂未连接' : '正在准备学习档案…'}}</view><view wx:if="{{syncError}}" class="muted">{{syncError}}</view><button wx:if="{{syncError}}" class="primary" bindtap="refresh">重试连接</button></view>
  <view wx:if="{{editTarget}}" class="edit-mask">
    <view class="edit-sheet">
      <view class="rule-title">调整学习安排</view><view class="task-title">{{editTarget.title}}</view>
      <view class="muted">原日期：{{editTarget.date}} · 仅调整这一次</view>
      <label class="label">改到哪一天</label><picker mode="date" value="{{editDate}}" start="{{today}}" end="{{maxPlanDate}}" bindchange="changeEditDate" disabled="{{busy}}"><view class="picker">{{editDate}} ▾</view></picker>
      <button class="primary" bindtap="saveTaskDate" loading="{{busy}}" disabled="{{busy || editDate === editTarget.date}}">保存日期</button>
      <button class="secondary edit-delete" bindtap="deleteTask" disabled="{{busy}}">删除这次安排</button>
      <view class="muted plan-help">已完成的学习记录和历史进度会保留。</view>
      <button class="quiet edit-cancel" bindtap="closeEdit" disabled="{{busy}}">取消</button>
    </view>
  </view>
</view>
