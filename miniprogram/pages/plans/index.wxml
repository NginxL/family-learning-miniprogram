<view class="page">
  <view class="row"><view class="title">明日计划</view><button class="quiet" bindtap="refresh">{{mode === 'demo' ? '本机保存' : syncLabel}} ↻</button></view>
  <view class="subtitle">{{date}} · {{weekdayLabel}}{{children.length === 1 ? ' · ' + children[0].name : ''}}</view>
  <view wx:if="{{mode === 'demo'}}" class="notice">本机演示 · 尚未连接家庭云数据</view>
  <view wx:if="{{syncError}}" class="notice">{{syncError}}。当前为已保存的预览，联网刷新后更新。</view>
  <block wx:if="{{family}}">
    <view wx:if="{{children.length > 1}}" class="tab-row"><view wx:for="{{children}}" wx:key="id" class="chip {{childId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectChild">{{item.name}}</view></view>
    <view wx:if="{{!isChild}}" class="segmented"><view class="segment {{editor === 'preview' ? 'selected' : ''}}" data-id="preview" bindtap="changeEditor">明日内容</view><view class="segment {{editor === 'auto' ? 'selected' : ''}}" data-id="auto" bindtap="changeEditor">任务模板</view><view class="segment {{editor === 'manual' ? 'selected' : ''}}" data-id="manual" bindtap="changeEditor">添加任务</view></view>
    <block wx:if="{{editor === 'preview' || isChild}}">
      <view class="card template-overview"><view class="row"><view class="grow"><view class="muted">明天使用{{weeklyEnabled ? ' · 按星期安排' : ''}}</view><view class="rule-title">{{previewTemplateName}}</view></view><button wx:if="{{!isChild}}" class="quiet" bindtap="openSchedule" disabled="{{busy}}">自动安排 ›</button></view></view>
      <view class="subtitle">共 {{tasks.length}} 项 · 约 {{minutes}} 分钟</view>
      <learning-card wx:for="{{groups}}" wx:key="id" data-id="{{item.id}}" bindopen="openGroup"
        title="{{item.label}}" tag="{{item.quantityLabel}}" subject="{{item.subject}}"
        meta="{{item.modeSummary}} · 约 {{item.minutes}} 分钟" preview="{{item.preview}}" status="待学习" />
      <view wx:for="{{dayWarnings}}" wx:key="kind" class="notice">{{item.message}}</view>
      <view wx:if="{{!groups.length}}" class="card empty">{{previewReady ? '明天还没有学习安排' : '正在读取明日安排…'}}</view>
      <button wx:if="{{!isChild}}" class="primary" bindtap="openLibrary">从知识库添加内容</button>
      <view class="muted plan-help">点击卡片查看任务、改期或删除，已完成记录保留。</view>
    </block>
    <block wx:elif="{{editor === 'auto'}}">
      <button class="schedule-entry" bindtap="openSchedule" disabled="{{busy}}"><view class="row"><text>自动安排</text><text>{{weeklyEnabled ? '按星期使用模板' : '每天使用同一模板'}} ›</text></view></button>
      <view class="card template-editor">
        <view class="row"><view class="rule-title">任务模板</view><button class="quiet" bindtap="createTemplate" disabled="{{busy}}">＋ 新建</button></view>
        <picker range="{{templates}}" range-key="label" value="{{templateIndex}}" bindchange="selectTemplate" disabled="{{busy || draftDirty}}"><view class="picker">{{newTemplateDraft ? '新模板' : templates[templateIndex].label}} ▾</view></picker>
        <input wx:if="{{newTemplateDraft}}" class="template-name" value="{{templateName}}" bindinput="changeTemplateName" maxlength="24" placeholder="模板名称，例如：上学日" disabled="{{busy}}" />
        <view class="quantity-list">
          <view wx:for="{{visibleRules}}" wx:key="id" class="quantity-row">
            <view class="grow"><view>{{item.label}}</view><view class="muted">{{item.unit}}</view></view>
            <view class="stepper"><button class="step" data-id="{{item.id}}" data-step="-1" bindtap="stepQuantity" disabled="{{busy}}">−</button><input class="quantity" type="number" maxlength="2" value="{{item.quantity}}" data-id="{{item.id}}" bindinput="changeQuantity" disabled="{{busy}}" /><button class="step" data-id="{{item.id}}" data-step="1" bindtap="stepQuantity" disabled="{{busy}}">＋</button></view>
          </view>
        </view>
        <view class="muted">每天 {{dailyCount}} 项 · 0 表示不安排</view>
        <button class="quiet advanced-toggle" bindtap="toggleTemplateAdvanced">{{templateAdvanced ? '收起更多设置 ↑' : '更多设置 · 新学／复习、范围 ↓'}}</button>
        <block wx:if="{{templateAdvanced}}">
          <block wx:if="{{!newTemplateDraft}}"><label class="label">模板名称</label><input class="template-name" value="{{templateName}}" bindinput="changeTemplateName" maxlength="24" placeholder="模板名称" disabled="{{busy}}" /></block>
          <view wx:for="{{visibleRules}}" wx:key="id" class="rule-settings">
            <view class="row"><view>{{item.label}}</view><picker range="{{modes}}" value="{{item.mode === 'review' ? 1 : 0}}" data-id="{{item.id}}" bindchange="changeMode" disabled="{{busy}}"><view class="mode-picker">{{item.mode === 'review' ? '复习' : '全新'}} ▾</view></picker></view>
            <picker range="{{item.scopes}}" range-key="label" value="{{item.scopeIndex}}" data-id="{{item.id}}" bindchange="changeScope" disabled="{{busy}}"><view class="picker">{{item.scopes[item.scopeIndex].label}} ▾</view></picker>
            <picker wx:if="{{item.id === 'poetry'}}" range="{{recitationPolicies}}" value="{{item.recitationPolicyIndex}}" bindchange="changeRecitationPolicy" disabled="{{busy}}"><view class="picker">{{recitationPolicies[item.recitationPolicyIndex]}} ▾</view></picker>
            <text wx:if="{{item.id === 'poetry' && item.recitationPolicy !== 'all'}}" class="muted">全新内容按年级、学期从低到高安排；必背范围不含旧版参考要求。</text>
            <button class="quiet" data-id="{{item.id}}" bindtap="browseRule">查看内容 · {{item.poolCount}} 项 →</button>
            <view wx:if="{{item.id === 'english-reading' && !item.poolCount}}" class="muted">请先在「添加任务」中录入英文文章，加入自动内容库。</view>
          </view>
          <view class="muted plan-help">全新过滤曾经安排过的内容；复习从已学内容中选择。内容不足时提示缺额。课标范围不代表完整的上海教材。</view>
          <button wx:if="{{templateCanDelete && !newTemplateDraft}}" class="quiet template-delete" bindtap="deleteTemplate" disabled="{{busy || draftDirty || templateConflict}}">删除这个模板</button>
        </block>
      </view>
      <view wx:if="{{templateConflict}}" class="notice">家人已更新模板，你的草稿已保留。<button class="quiet" bindtap="resetRules" disabled="{{busy}}">放弃草稿并重新载入</button></view>
      <button class="primary" bindtap="saveTemplate" loading="{{busy}}" disabled="{{busy || templateConflict}}">保存模板</button>
      <button wx:if="{{draftDirty}}" class="quiet discard-draft" bindtap="resetRules" disabled="{{busy}}">放弃修改</button>
      <view class="muted plan-help">新模板保存后，可在「自动安排」中选择使用。今日任务和已完成记录保留。</view>
    </block>
    <block wx:else>
      <view class="card"><form bindsubmit="addPlan">
        <view class="rule-title">为 {{children[childIndex].name}} 添加内容</view>
        <label class="label">学习类型</label><picker range="{{kinds}}" range-key="label" value="{{kindIndex}}" bindchange="changeKind"><view class="picker">{{kinds[kindIndex].label}} ▾</view></picker>
        <label class="label">怎样安排</label><picker range="{{schedules}}" value="{{scheduleIndex}}" bindchange="changeSchedule"><view class="picker">{{schedules[scheduleIndex]}} ▾</view></picker>
        <block wx:if="{{scheduleIndex !== 2}}"><label class="label">{{scheduleIndex === 1 ? '开始日期' : '学习日期'}}</label><picker mode="date" value="{{planDate}}" start="{{today}}" end="{{maxPlanDate}}" bindchange="changePlanDate"><view class="picker">{{planDate}}{{planDate === date ? ' · 明日' : planDate === today ? ' · 今日' : ''}} ▾</view></picker></block>
        <view wx:if="{{scheduleIndex === 2}}" class="muted" style="margin-top:10rpx">保存到内容库，按上方自动安排的数量选取；一条内容计一项。</view>
        <label class="label">名称</label><input name="title" value="{{formTitle}}" maxlength="60" placeholder="例如：apple ／《小池》／绘本第 1–3 页" />
        <label class="label">正文或学习提示</label><textarea name="detail" value="{{formDetail}}" maxlength="2000" placeholder="单词释义、诗文正文、句子，或读书页码和问题" auto-height />
        <label class="label">预计分钟数</label><input name="minutes" value="{{formMinutes}}" type="number" maxlength="3" placeholder="5" />
        <label class="label">内容年级（家长标注，选填）</label><picker range="{{gradeLabels}}" value="{{studyGrade}}" bindchange="changeStudyGrade"><view class="picker">{{gradeLabels[studyGrade]}} ▾</view></picker><view class="muted">依据孩子的课本填写；会与教材已核实的进度分别展示。</view>
        <button class="primary" form-type="submit" loading="{{busy}}" disabled="{{busy}}">{{scheduleIndex === 2 ? '加入内容库' : '添加学习安排'}}</button>
      </form></view>
      <view class="section">家长添加的内容</view>
      <learning-card wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bindopen="openPlan" title="{{item.title}}"
        tag="{{item.kindLabel}}" subject="{{item.subject}}" meta="{{item.scheduleLabel}}" preview="{{item.poetryByline}}" status="{{item.enabled ? '已启用' : '已暂停'}}" has-actions="{{true}}">
        <view slot="actions" class="learning-card-actions"><switch checked="{{item.enabled}}" disabled="{{busy}}" color="#27654c" data-id="{{item.id}}" bindchange="togglePlan" aria-label="{{item.enabled ? '暂停' : '启用'}}{{item.title}}" /></view>
      </learning-card>
      <view wx:if="{{!plans.length}}" class="muted">还没有手动添加的内容。</view>
      <view class="muted plan-help">暂停只影响后续安排，已生成的任务和学习记录会保留。</view>
    </block>
  </block>
  <view wx:else class="card empty"><view>{{syncError ? '学习档案暂未连接' : '正在准备学习档案…'}}</view><view wx:if="{{syncError}}" class="muted">{{syncError}}</view><button wx:if="{{syncError}}" class="primary" bindtap="refresh">重试连接</button></view>
  <view wx:if="{{scheduleDraft}}" class="edit-mask">
    <view class="edit-sheet schedule-sheet">
      <view class="rule-title">自动安排</view>
      <view class="row weekly-switch"><view class="grow">按星期使用不同模板</view><switch checked="{{scheduleDraft.weekly}}" bindchange="changeWeekly" color="#27654c" disabled="{{busy}}" /></view>
      <view wx:for="{{scheduleRows}}" wx:key="slot" class="schedule-choice">
        <view class="label">{{item.label}}</view><picker range="{{templates}}" range-key="name" value="{{item.index}}" data-slot="{{item.slot}}" bindchange="chooseScheduleTemplate" disabled="{{busy}}"><view class="picker">{{item.index >= 0 ? templates[item.index].name : '模板已变更，请重新载入'}} ▾</view></picker>
      </view>
      <view wx:if="{{scheduleConflict}}" class="notice">家人已更新模板或安排。<button class="quiet" bindtap="openSchedule" disabled="{{busy}}">重新载入</button></view>
      <view class="muted plan-help">{{scheduleDraft.weekly ? '按自然星期循环，后续每天自动选择模板。' : '后续每天使用选中的模板。'}}今日已生成的任务保持不变。</view>
      <button class="primary" bindtap="saveSchedule" loading="{{busy}}" disabled="{{busy || scheduleConflict}}">保存安排</button>
      <button class="quiet edit-cancel" bindtap="closeSchedule" disabled="{{busy}}">取消</button>
    </view>
  </view>
</view>
