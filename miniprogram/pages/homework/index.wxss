.section { margin-top:0; }
.attachment { padding:22rpx 0; border-bottom:1rpx solid #edf0e9; }
.attachment button { margin-top:0; min-height:88rpx; display:flex; align-items:center; justify-content:center; }
.photo { display:block; width:100%; height:320rpx; border-radius:16rpx; background:#f5f6f2; margin-bottom:18rpx; }
.capture-actions button { width:auto; min-height:88rpx; }
.privacy-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000; background: rgba(0,0,0,.45); display: flex; align-items: center; padding: 32rpx; }
.privacy-card { width: 100%; max-height: 85vh; overflow-y: auto; box-sizing: border-box; }
