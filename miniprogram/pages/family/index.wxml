<view class="page">
  <view class="eyebrow">一点一滴 · 每日成长</view><view class="title">{{family ? family.name : '学习档案'}}</view>
  <view wx:if="{{mode === 'demo'}}" class="notice">本机演示 · 数据保存在这台设备</view>
  <view wx:if="{{syncError}}" class="notice">{{syncError}}</view>
  <view wx:if="{{!family}}" class="card empty"><view>{{syncError ? '学习档案暂未连接' : '正在准备学习档案…'}}</view><button wx:if="{{syncError}}" class="primary" bindtap="refresh">重试连接</button></view>
  <block wx:else>
    <view class="pill">{{isChild ? '孩子身份 · 由家长确认完成' : '家长身份'}}</view>
    <view class="status" bindtap="refresh">{{mode === 'demo' ? '本机保存' : syncLabel}} ↻</view>
    <view class="card">
      <view class="section" style="margin-top:0">孩子的学习档案</view>
      <view wx:for="{{children}}" wx:key="id" class="member"><view class="row"><view class="grow"><view>🌱 {{item.name}}</view><view class="muted">{{item.age != null ? item.age + ' 岁 · ' : ''}}在读：{{item.gradeLabel}}</view></view><button wx:if="{{family.myRole === 'owner'}}" class="quiet" data-id="{{item.id}}" bindtap="editChild">编辑</button></view><button class="quiet" data-id="{{item.id}}" bindtap="openProgress">查看知识进度 →</button><button wx:if="{{mode === 'cloud' && family.myRole === 'owner'}}" class="secondary" data-id="{{item.id}}" loading="{{bindingChildId === item.id}}" disabled="{{busy || bindingChildId}}" bindtap="createChildInvite">绑定这个孩子的微信</button>
        <view wx:if="{{inviteCode && inviteChildId === item.id && family.myRole === 'owner'}}" class="notice"><view>{{inviteLabel}}</view><view class="invite">{{inviteCode}}</view><view class="muted">让孩子用自己的微信打开小程序，在「家庭 → 家人管理」输入此码。24 小时内有效，仅可用一次；新码生成后旧码失效。</view><button class="quiet" bindtap="copyInvite">复制孩子绑定码</button></view>
      </view>
      <form wx:if="{{editingChild && family.myRole === 'owner'}}" bindsubmit="saveChild"><view>
        <label class="label">昵称</label><input name="name" value="{{editingChild.name}}" maxlength="16" />
        <label class="label">出生日期（选填）</label><picker mode="date" end="{{today}}" value="{{editBirthDate}}" data-field="editBirthDate" bindchange="changeBirthDate"><view class="picker">{{editBirthDate || '选择出生日期'}} ▾</view></picker>
        <view wx:if="{{editBirthDate}}" class="row"><view class="muted grow">当前 {{editCurrentAge}} 岁 · 按生日自动更新</view><button class="quiet" data-field="editBirthDate" bindtap="clearBirthDate">清除</button></view>
        <view wx:else><label class="label">年龄（选填）</label><input name="age" value="{{editingChild.age}}" type="number" maxlength="2" placeholder="周岁" /></view>
        <label class="label">在读年级</label><picker range="{{gradeLabels}}" value="{{editGrade}}" data-field="editGrade" bindchange="changeGrade"><view class="picker">{{gradeLabels[editGrade]}} ▾</view></picker>
        <button class="primary" form-type="submit" loading="{{busy}}" disabled="{{busy}}">保存档案</button><button class="quiet" bindtap="cancelEdit">取消</button>
      </view></form>
      <form wx:elif="{{addingChild && family.myRole === 'owner'}}" bindsubmit="addChild"><view>
        <label class="label">孩子昵称</label><input name="name" value="{{newChildName}}" maxlength="16" placeholder="另一个孩子的昵称" />
        <label class="label">出生日期（选填）</label><picker mode="date" end="{{today}}" value="{{addBirthDate}}" data-field="addBirthDate" bindchange="changeBirthDate"><view class="picker">{{addBirthDate || '选择出生日期'}} ▾</view></picker>
        <view wx:if="{{addBirthDate}}" class="row"><view class="muted grow">当前 {{addCurrentAge}} 岁 · 按生日自动更新</view><button class="quiet" data-field="addBirthDate" bindtap="clearBirthDate">清除</button></view>
        <view wx:else><label class="label">年龄（选填）</label><input name="age" value="{{newChildAge}}" type="number" maxlength="2" placeholder="周岁" /></view>
        <label class="label">在读年级（选填）</label><picker range="{{gradeLabels}}" value="{{addGrade}}" data-field="addGrade" bindchange="changeGrade"><view class="picker">{{gradeLabels[addGrade]}} ▾</view></picker>
        <button class="secondary" form-type="submit" loading="{{busy}}" disabled="{{busy}}">添加孩子</button><button class="quiet" bindtap="toggleAddChild">取消</button>
      </view></form>
      <button wx:elif="{{family.myRole === 'owner'}}" class="quiet plan-help" bindtap="toggleAddChild">＋ 添加孩子档案</button>
    </view>
    <button class="quiet plan-help" bindtap="toggleManageFamily">{{manageFamily ? '收起家人管理 ↑' : '家人管理 ↓'}}</button>
    <view wx:if="{{manageFamily}}" class="card">
      <view class="section" style="margin-top:0">陪伴的家人</view>
      <view wx:for="{{members}}" wx:key="id" class="member row"><view class="grow"><view>{{item.name}} <text wx:if="{{item.isMe && item.name !== '我'}}" class="muted">（我）</text></view><view class="muted">{{item.roleLabel}}</view></view><button wx:if="{{family.myRole === 'owner' && !item.isMe}}" class="quiet danger" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="removeMember">移除</button></view>
      <block wx:if="{{mode === 'cloud' && family.myRole === 'owner'}}"><button class="secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="createInvite">生成家人邀请码</button>
        <view wx:if="{{inviteCode && !inviteChildId}}" class="notice"><view>{{inviteLabel}}</view><view class="invite">{{inviteCode}}</view><view class="muted">24 小时内有效，仅可使用一次；生成新码后旧码失效。孩子用自己的微信打开「家庭 → 家人管理」，输入此码绑定。</view><button class="quiet" bindtap="copyInvite">复制邀请码</button></view>
      </block>
      <form wx:if="{{mode === 'cloud' && family.canJoinFamily}}" bindsubmit="joinFamily"><view>
        <view class="section">使用家长邀请码／孩子绑定码</view>
        <label class="label">邀请码</label><input name="code" maxlength="32" placeholder="粘贴家人给你的邀请码" />
        <label class="label">你的称呼</label><input name="memberName" maxlength="16" value="我" placeholder="家人怎么称呼你" />
        <button class="secondary" form-type="submit" disabled="{{busy}}" loading="{{busy}}">使用邀请码加入</button>
      </view></form>
      <button wx:if="{{family.myRole === 'guardian'}}" class="quiet danger plan-help" bindtap="leaveFamily">退出家庭</button>
    </view>
  </block>
  <navigator class="status plan-help" url="/pages/privacy/index">隐私与数据管理 →</navigator>
</view>
