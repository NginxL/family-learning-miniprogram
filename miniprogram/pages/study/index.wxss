@import "../../styles/study-content.wxss";
@import "../../styles/edit-sheet.wxss";
.study-page { padding-bottom:240rpx; padding-bottom:calc(240rpx + env(safe-area-inset-bottom)); }
.study-page.planning-page { padding-bottom:64rpx; }
.study-summary { margin-top:20rpx; }
.sync-button { min-height:80rpx; display:flex; align-items:center; justify-content:center; }
.load-more { min-height:88rpx; }
.study-end { margin:30rpx 0; text-align:center; }
.study-footer { position:fixed; bottom:0; left:0; right:0; z-index:10; background:#fff; padding:18rpx 32rpx 24rpx; padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); box-shadow:0 -4rpx 24rpx rgba(37,59,50,.06); }
.footer-summary { text-align:center; }
.study-footer button { margin-top:12rpx; min-height:88rpx; }
