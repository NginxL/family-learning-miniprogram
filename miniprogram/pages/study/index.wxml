<view class="page study-page">
  <view wx:if="{{mode === 'demo'}}" class="notice">本机演示 · 数据仅保存在这台设备，未连接云端</view>
  <view wx:if="{{notice}}" class="notice" bindtap="dismissNotice">{{notice}}　×</view>
  <view wx:if="{{syncError}}" class="notice">{{syncError}}。已保存的任务仍可查看和打卡。</view>
  <block wx:if="{{group}}">
    <view class="eyebrow">{{childName}} · {{date}}</view>
    <view class="row"><view class="title grow">{{group.label}}</view><view class="pill {{group.subject}}">{{group.quantityLabel}}</view></view>
    <view wx:if="{{isChild}}" class="notice">孩子身份 · 学完提交录音或照片，由家长确认完成。</view>
    <button wx:else class="secondary" bindtap="openHomework">查看孩子提交的作业 →</button>
    <view class="subtitle">{{group.modeSummary}} · 约 {{group.minutes}} 分钟</view>
    <view class="row study-summary"><view class="muted">{{group.doneCount}} / {{group.count}} 已完成</view><button class="quiet sync-button" bindtap="refresh">{{mode === 'demo' ? '本机保存' : syncLabel}} ↻</button></view>
    <view wx:for="{{items}}" wx:key="id" class="card study-item">
      <view class="row"><view class="pill {{item.subject}}">{{item.modeLabel}}</view><view class="muted">{{item.pending ? '待同步' : item.done ? '已完成' : '待学习'}} · {{index + 1}} / {{group.count}}</view></view>
      <view class="task-title">{{item.title}}</view>
      <view class="body"><text selectable="true">{{item.detail || '和家人一起完成这项学习。'}}</text></view>
      <view wx:if="{{item.note}}" class="study-note">{{item.note}}</view>
      <view wx:if="{{item.source}}" class="muted study-source">来源：{{item.source}}</view>
    </view>
    <button wx:if="{{items.length < group.count}}" class="secondary load-more" bindtap="showMore">再看 {{group.count - items.length > 20 ? 20 : group.count - items.length}} 项 · 已展示 {{items.length}} / {{group.count}}</button>
    <view wx:else class="muted study-end">本组共 {{group.count}} 项，已全部展示</view>
    <view class="study-footer">
      <view class="muted footer-summary">{{group.doneCount}} / {{group.count}} 已完成<text wx:if="{{group.pendingCount}}"> · {{group.pendingCount}} 项待同步</text></view>
      <button wx:if="{{isChild}}" class="primary" bindtap="openHomework">{{group.done ? '查看已确认的作业' : '提交作业'}}</button>
      <button wx:else class="{{group.done ? 'secondary' : 'primary'}}" disabled="{{busy}}" loading="{{busy}}" bindtap="toggleGroup">{{group.done ? '已完成 · 撤销本组' : group.doneCount ? '完成本组剩余内容' : '完成本组'}}</button>
    </view>
  </block>
  <view wx:else class="card empty">
    <view class="section">{{pageError ? '暂时无法查看' : loading ? '正在准备学习内容…' : '暂无学习内容'}}</view>
    <view class="subtitle">{{pageError || (loading ? '请稍候，正在读取这一天的任务。' : emptyMessage)}}</view>
    <button wx:if="{{!pageError}}" class="primary" bindtap="refresh">重新加载</button>
    <button class="secondary" bindtap="openToday">返回今日</button>
  </view>
</view>
