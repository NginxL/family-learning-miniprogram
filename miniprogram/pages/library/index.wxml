<import src="../../templates/pinyin.wxml" />
<import src="../../templates/study-notes.wxml" />
<view class="page">
  <view class="eyebrow">慢慢读 · 一点点积累</view><view class="title">知识库</view>
  <view class="subtitle">{{poemCount}} 篇 / 组古诗文 · {{wordCount}} 项英语词汇</view>
  <view class="muted">{{readingCount}} 项语文阅读与练习 · {{englishReadingCount}} 篇英语短文</view>
  <view class="muted">{{foundationCount}} 组背诵、文言与英语基础知识练习</view>
  <view class="tab-row"><view wx:for="{{children}}" wx:key="id" class="chip {{childId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectChild">{{item.name}}</view></view>
  <view class="segmented"><view class="segment {{view === 'content' ? 'selected' : ''}}" data-id="content" bindtap="changeView">选内容</view><view class="segment {{view === 'exam' ? 'selected' : ''}}" data-id="exam" bindtap="changeView">上海中考</view><view class="segment {{view === 'books' ? 'selected' : ''}}" data-id="books" bindtap="changeView">教材与来源</view></view>
  <block wx:if="{{view === 'content'}}">
    <view class="tab-row subjects"><view wx:for="{{subjectOptions}}" wx:key="id" class="subject-chip {{subjectFilter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectSubject">{{item.label}}</view></view>
    <input value="{{query}}" maxlength="80" placeholder="搜篇名、单词或知识点" bindinput="typeQuery" />
    <view class="filter-summary" bindtap="toggleFilters">{{learningAreaIndex ? learningAreas[learningAreaIndex].label : kinds[kindIndex].label}} · {{gradeLabels[grade]}} · {{semesterLabels[semesterIndex]}} {{filtersOpen ? '↑' : '· 筛选 ↓'}}</view>
    <block wx:if="{{filtersOpen}}">
    <view class="row"><picker class="grow" range="{{kinds}}" range-key="label" value="{{kindIndex}}" bindchange="changeKind"><view class="picker">{{kinds[kindIndex].label}} ▾</view></picker></view>
    <picker range="{{learningAreas}}" range-key="label" value="{{learningAreaIndex}}" bindchange="changeLearningArea"><view class="picker">{{learningAreas[learningAreaIndex].label}} ▾</view></picker>
    <picker range="{{scopes}}" range-key="label" value="{{scopeIndex}}" bindchange="changeScope"><view class="picker">{{scopes[scopeIndex].label}} ▾</view></picker>
    <picker range="{{gradeLabels}}" value="{{grade}}" bindchange="changeGrade"><view class="picker">{{gradeLabels[grade]}} ▾</view></picker>
    <picker range="{{semesterLabels}}" value="{{semesterIndex}}" bindchange="changeSemester"><view class="picker">{{semesterLabels[semesterIndex]}} ▾</view></picker>
    <picker wx:if="{{family}}" range="{{learningFilterLabels}}" value="{{learningFilterIndex}}" bindchange="changeLearningFilter"><view class="picker">{{learningFilterLabels[learningFilterIndex]}} ▾</view></picker>
    <view wx:if="{{grade || semesterIndex}}" class="muted">教材字词、古诗与单元原创练习分别标注；尚未覆盖整年级。</view>
    </block>
    <view wx:if="{{bookId}}" class="notice" bindtap="clearBook">{{bookTitle}} · 清除筛选 ×</view>
    <picker wx:if="{{bookId && bookUnits.length > 1}}" range="{{bookUnits}}" range-key="label" value="{{unitIndex}}" bindchange="changeUnit"><view class="picker">{{bookUnits[unitIndex].label}} ▾</view></picker>
    <view class="row"><view class="section">可选内容 {{total}} 项</view><button class="quiet" bindtap="openPlans">设每日数量 →</button></view>
    <view class="muted" bindtap="toggleCoverage">国家课标底库 + 五四制教材关联内容 {{coverageOpen ? '↑' : '· 查看覆盖范围 ↓'}}</view>
    <view wx:if="{{coverageOpen}}" class="notice">{{resources.coverage}}</view>
    <view wx:if="{{family && learningFilterIndex}}" class="muted">{{learningFilterLabels[learningFilterIndex]}}</view>
    <view wx:if="{{family && !learningReady}}" class="muted">{{learningBusy ? '正在读取学习记录…' : '学习记录暂未加载；当前展示全部内容。'}}</view>
    <view wx:if="{{learningCached}}" class="muted">已学标记来自本机缓存，联网刷新后更新。</view>
    <view wx:if="{{learningError}}" class="notice" bindtap="loadLearningStatus">{{learningError}} · 点击重试</view>
    <view wx:for="{{items}}" wx:key="id" class="card">
      <view class="row"><view class="pill {{item.subject}}">{{item.kindLabel}}</view><view class="library-status"><view wx:if="{{item.learnedLabel}}" class="learned-badge">{{item.learnedLabel}}</view><view wx:if="{{item.assigned}}" class="muted">已在今日</view></view></view>
      <view class="task-title" data-id="{{item.id}}" bindtap="expandContent"><template is="pinyinText" data="{{enabled: showPinyin && expandedId === item.id, lines: item.pinyin.title, text: item.title}}" /></view>
      <view class="muted library-preview">{{item.preview}}</view>
      <view class="muted">{{item.gradeLabel}}</view>
      <block wx:if="{{expandedId === item.id}}">
        <view wx:if="{{item.learnedLabel}}" class="muted plan-help">最近学习 {{item.lastLearned}} · 已学 {{item.learnedCount}} 次</view>
        <button wx:if="{{item.pinyin}}" class="quiet pinyin-toggle" bindtap="togglePinyin">{{showPinyin ? '隐藏拼音' : '显示拼音'}}</button>
        <view class="body"><template is="pinyinText" data="{{enabled: showPinyin, lines: item.pinyin.body, text: item.displayDetail || item.detail}}" /></view><view wx:if="{{item.dynastyNote}}" class="muted">{{item.dynastyNote}}</view><view class="muted">{{item.source}}</view><view wx:if="{{item.note}}" class="muted plan-help">{{item.note}}</view>
        <view wx:if="{{item.recitationNote}}" class="body muted">{{item.recitationNote}}</view>
        <template is="studyNotes" data="{{item, notesOpenId, notesAnswersId}}" />
        <view wx:for="{{item.gradeMappings}}" wx:for-item="mapping" wx:key="displayKey" class="muted plan-help"><view>{{gradeLabels[mapping.grade]}} {{mapping.semester}} · {{mapping.edition}}</view><view wx:if="{{mapping.sourcePrintPage}}">{{mapping.unit}} · 原书第 {{mapping.sourcePrintPage}} 页<text wx:if="{{mapping.sourcePdfPage}}"> / PDF 第 {{mapping.sourcePdfPage}} 页</text></view><view>{{mapping.evidence}}</view><button class="quiet" data-url="{{mapping.sourceUrl}}" bindtap="copySource">复制年级依据链接</button></view>
        <view class="tab-row"><button wx:if="{{item.referenceUrl}}" class="quiet" data-url="{{item.referenceUrl}}" bindtap="copySource">复制目录来源链接</button><button wx:if="{{item.textSourceUrl}}" class="quiet" data-url="{{item.textSourceUrl}}" bindtap="copySource">复制正文 / 词典来源</button></view>
      </block>
      <view class="row" style="margin-top:20rpx"><button class="quiet" data-id="{{item.id}}" bindtap="expandContent">{{expandedId === item.id ? '收起 ↑' : '看看内容 ↓'}}</button><button wx:if="{{family && !isChild}}" class="small secondary" style="margin:0" data-id="{{item.id}}" bindtap="assignItem" disabled="{{busy}}">安排日期</button></view>
    </view>
    <view wx:if="{{!items.length}}" class="card empty">{{learningFilterIndex && learningReady ? '当前筛选范围没有符合该学习状态的内容，试试全部学习状态。' : grade ? '这个筛选范围尚无已核实的年级内容，不代表这个年级没有学习要求。' : '没有匹配的内容，试试其他关键词或范围。'}}</view>
    <button wx:if="{{hasMore}}" class="secondary" bindtap="loadMore">再看 30 项</button>
    <button wx:if="{{family}}" class="quiet plan-help" bindtap="openToday">查看今日任务 →</button>
    <button wx:elif="{{syncError}}" class="primary" bindtap="refresh">重试连接学习档案</button>
  </block>
  <block wx:elif="{{view === 'exam'}}">
    <view class="card"><view class="rule-title">{{resources.examFramework.title}}</view><view class="body">{{resources.examFramework.summary}}</view><view class="muted">{{resources.examFramework.versionNote}}</view></view>
    <view class="notice">{{resources.examFramework.scoreNote}}</view>
    <view class="section">积累方向与当前覆盖</view>
    <view wx:for="{{resources.examFramework.areas}}" wx:key="id" class="card">
      <view class="rule-title">{{item.title}}</view><view class="body">{{item.requirement}}</view>
      <view class="pill">{{item.statusLabel}}</view><view class="subtitle">{{item.available}}</view><view class="muted plan-help">待补齐：{{item.gap}}</view>
      <button wx:if="{{item.kind}}" class="quiet" data-kind="{{item.kind}}" data-area="{{item.learningArea}}" bindtap="showExamContent">查看现有学习内容 →</button>
    </view>
    <view class="notice">{{resources.examFramework.measurementNote}}</view>
    <button wx:if="{{family}}" class="secondary" bindtap="openPlans">安排日常积累与家长自选练习</button>
    <view class="section">官方依据 · 保留年份</view>
    <view wx:for="{{resources.examFramework.sources}}" wx:key="id" class="card"><view class="rule-title">{{item.title}}</view><view class="muted plan-help">{{item.note}}</view><button class="quiet" data-url="{{item.url}}" bindtap="copySource">复制依据链接</button></view>
    <view class="section">历史资料 · 不作为现行清单</view>
    <view wx:for="{{resources.examFramework.historicalReferences}}" wx:key="id" class="card"><view class="rule-title">{{item.title}}</view><view class="muted plan-help">{{item.note}}</view><button class="quiet" data-url="{{item.url}}" bindtap="copySource">复制历史资料链接</button></view>
  </block>
  <block wx:else>
    <view class="card"><view class="rule-title">内容覆盖</view><view class="body">{{resources.coverage}}</view><view class="muted">国家底库：古诗文 75 + 60 篇 / 组；英语 1600 个主词条，其中 505 个二级带星词，另有 77 项另列表。教材补充、原创练习与底库分别计数。核对日期 {{resources.checkedAt}}。</view></view>
    <view class="section">上海五四学制 · 逐册覆盖</view>
    <view class="muted">{{resources.curriculum.target}}</view>
    <picker range="{{curriculumGradeLabels}}" value="{{curriculumGradeIndex}}" bindchange="changeCurriculumGrade"><view class="picker">{{curriculumGradeLabels[curriculumGradeIndex]}} ▾</view></picker>
    <view wx:for="{{curriculumSlots}}" wx:key="id" class="card">
      <view class="row"><view class="rule-title">{{item.subjectLabel}} · {{item.semester}}</view><view class="pill">{{item.verifiedCount ? '部分入库' : '知识待核验'}}</view></view>
      <view wx:if="{{item.editionReview}}" class="notice">
        <view>旧版参考 · 新版待核实</view>
        <view class="muted">核验于 {{item.editionReview.checkedAt}}</view>
        <view class="plan-help">{{item.editionReview.summary}}</view>
        <view class="muted plan-help">{{item.editionReview.pending}}</view>
        <button class="quiet" data-url="{{item.editionReview.url}}" bindtap="copySource">复制版本核验依据</button>
      </view>
      <view class="body">{{item.contentNote}}</view>
      <view wx:for="{{item.references}}" wx:for-item="reference" wx:key="title" class="plan-help">
        <view>{{reference.title}}</view><view class="muted">{{reference.publisher}} · {{reference.period}}</view>
        <view wx:if="{{reference.verification === 'historical_resource_listing'}}" class="muted">上一学年参考，当前学年下册版次待确认。</view>
        <button class="quiet" data-url="{{reference.url}}" bindtap="copySource">复制教材来源链接</button>
      </view>
      <view class="muted">教材名称已核实；学校选用、全册知识及正文校对分别核验。</view>
      <view wx:if="{{item.mappingNote}}" class="muted plan-help">{{item.mappingNote}}</view>
      <button wx:if="{{item.contentBookId && item.verifiedCount}}" class="quiet" data-id="{{item.contentBookId}}" bindtap="showBook">查看学习内容 →</button>
    </view>
    <view class="section">官方资源</view>
    <view wx:for="{{resources.links}}" wx:key="url" class="card"><view class="rule-title">{{item.title}}</view><view class="muted plan-help">{{item.note}}</view><button class="quiet" data-url="{{item.url}}" bindtap="copySource">复制链接</button></view>
    <view class="muted plan-help">内置文字可离线查看；完整课本仍由官方平台提供阅读，当前没有缓存整册课本。课本正文、录音、现代注释的使用范围与源代码开源许可分别管理。</view>
  </block>
</view>
<view wx:if="{{assignTarget}}" class="schedule-mask" catchtap="closeAssign" catchtouchmove="keepSheet">
  <view class="schedule-sheet" catchtap="keepSheet">
    <view class="rule-title">安排学习日期</view>
    <view class="subtitle">{{assignTarget.childName}} · {{assignTarget.title}}</view>
    <view class="schedule-shortcuts"><button class="{{assignDate === today ? 'selected' : ''}}" data-date="{{today}}" bindtap="chooseAssignDate" disabled="{{busy}}">今日</button><button class="{{assignDate === tomorrow ? 'selected' : ''}}" data-date="{{tomorrow}}" bindtap="chooseAssignDate" disabled="{{busy}}">明日</button></view>
    <label class="label">也可以选择未来日期</label><picker mode="date" value="{{assignDate}}" start="{{today}}" end="{{maxPlanDate}}" bindchange="changeAssignDate" disabled="{{busy}}"><view class="picker">{{assignDate}} ▾</view></picker>
    <button class="primary" bindtap="confirmAssign" loading="{{busy}}" disabled="{{busy}}">加入 {{assignDate === today ? '今日' : assignDate === tomorrow ? '明日' : assignDate}}</button>
    <button class="quiet schedule-cancel" bindtap="closeAssign" disabled="{{busy}}">取消</button>
  </view>
</view>
