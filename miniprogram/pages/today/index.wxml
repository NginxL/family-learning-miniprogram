<view class="page">
  <view class="eyebrow">一点一滴 · 每日成长</view>
  <view class="row"><view class="title">小小日课</view><picker mode="date" value="{{date}}" end="{{today}}" bindchange="changeDate"><view class="pill">{{date}} ▾</view></picker></view>
  <view wx:if="{{mode === 'demo'}}" class="notice">本机演示 · 数据仅保存在这台设备，未连接云端</view>
  <view wx:if="{{notice}}" class="notice" bindtap="dismissNotice">{{notice}}　×</view>
  <view wx:if="{{syncError}}" class="notice">{{syncError}}。已保存的任务仍可查看和打卡。</view>
  <block wx:if="{{family}}">
    <view class="status">{{isChild ? '孩子身份 · 完成由家长确认' : '家长身份'}}</view>
    <view class="tab-row"><view wx:for="{{children}}" wx:key="id" class="chip {{childId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectChild">{{item.name}}</view></view>
    <view class="card hero">
      <view class="row"><view class="grow"><view>{{date === today ? '今天，也进步一点点' : '一起回顾这一天'}}</view><view class="subtitle"><view>{{groupCount}} 类学习 · {{allTaskCount}} 项内容</view><view>约 {{minutes}} 分钟</view></view></view><view class="activity-total"><text class="big-number">{{doneGroupCount}}</text><text> / {{groupCount}}</text><view class="subtitle">类已完成</view></view></view>
      <view class="meter"><view class="meter-fill" style="width:{{groupPercent}}%"></view></view>
    </view>
    <view class="tab-row subjects"><view wx:for="{{subjectOptions}}" wx:key="id" class="subject-chip {{subjectFilter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectSubject">{{item.label}}<text wx:if="{{item.count}}"> {{item.count}}</text></view></view>
    <view class="row"><view class="section">{{date === today ? '今日学习' : '学习记录'}}</view><view class="status" bindtap="refresh">{{mode === 'demo' ? '本机保存' : syncLabel}} ↻</view></view>
    <view wx:for="{{dayWarnings}}" wx:key="kind" class="notice">{{item.message}}</view>
    <learning-card wx:for="{{groups}}" wx:for-item="group" wx:key="id" data-id="{{group.id}}" bindopen="openGroup"
      title="{{group.label}}" tag="{{group.quantityLabel}}" subject="{{group.subject}}" completed="{{group.done}}"
      meta="{{group.modeSummary}} · 约 {{group.minutes}} 分钟" preview="{{group.preview}}"
      status="{{group.doneCount}} / {{group.count}} 已完成{{group.pendingCount ? ' · 待同步' : ''}}" has-actions="{{true}}">
      <view slot="actions" class="learning-card-actions"><button wx:if="{{isChild}}" class="small secondary" data-id="{{group.id}}" catchtap="openGroup">{{group.done ? '查看作业' : '查看并提交'}}</button><button wx:else class="small {{group.done ? 'secondary' : 'primary'}}" data-id="{{group.id}}" catchtap="toggleGroup">{{group.done ? '已完成 · 撤销' : group.doneCount ? '完成剩余' : '完成本组'}}</button></view>
    </learning-card>
    <view wx:if="{{!tasks.length}}" class="card empty"><view class="empty-icon">☀</view><view>{{subjectFilter === 'all' ? '这一天还没有学习任务' : '这个科目还没有学习任务'}}</view><view class="subtitle">{{date === today ? '设置每天数量，或由家长添加内容' : '这一天没有已保存的任务记录'}}</view><button wx:if="{{date === today}}" class="secondary" bindtap="openPlans">安排学习内容</button></view>
    <button wx:if="{{date !== today}}" class="secondary" bindtap="backToday">回到今天</button>
  </block>
  <view wx:else class="card empty"><view class="empty-icon">🌱</view><view class="section">{{syncError ? '暂时连接不上学习档案' : '正在准备今日学习…'}}</view><view class="subtitle">{{syncError ? '联网后重试即可继续。' : '首次打开会自动准备好孩子的档案和每日任务。'}}</view><button wx:if="{{syncError}}" class="primary" bindtap="refresh">重试连接</button></view>
</view>
