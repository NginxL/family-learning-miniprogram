page { background:#f6f5ef; color:#253b32; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:28rpx; line-height:1.6; }
.page { box-sizing:border-box; width:100%; padding:32rpx 32rpx 64rpx; overflow-wrap:break-word; }
view, form, button { box-sizing:border-box; }
form { display:block; width:100%; }
.eyebrow { color:#6f806f; font-size:22rpx; letter-spacing:4rpx; margin:8rpx 0 14rpx; }
.title { font-size:48rpx; font-weight:600; line-height:1.3; }
.subtitle { font-size:26rpx; color:#738077; margin-top:14rpx; line-height:1.7; }
.card { background:#fff; border-radius:28rpx; padding:30rpx; margin-top:24rpx; box-shadow:0 6rpx 22rpx rgba(37,59,50,.035); }
.hero { background:#27654c; color:#fff; }
.hero .subtitle { color:#d6e6db; }
.row { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16rpx; }
.row > view { min-width:0; }
.section { font-size:32rpx; font-weight:600; margin:34rpx 0 10rpx; }
.muted { color:#7b857f; font-size:24rpx; line-height:1.7; }
.pill { display:inline-block; background:#eaf0e6; color:#426348; padding:7rpx 16rpx; border-radius:24rpx; font-size:22rpx; }
.english { background:#edf0fb; color:#62699a; }
.other { background:#f9eee1; color:#98734b; }
.notice { background:#fff3d8; color:#7b602c; padding:20rpx 24rpx; border-radius:16rpx; font-size:24rpx; line-height:1.6; margin:18rpx 0; }
.status { color:#657c6e; font-size:22rpx; margin-top:18rpx; }
button { font-size:28rpx; border-radius:18rpx; margin:0; font-weight:500; max-width:100%; line-height:1.6; padding:18rpx 24rpx; white-space:normal; }
button::after { border:0; }
.primary { background:#27654c; color:#fff; margin-top:24rpx; }
.secondary { background:#edf2eb; color:#315e43; margin-top:20rpx; }
.small { font-size:24rpx; padding:0 22rpx; line-height:2.7; }
.quiet { background:transparent; color:#66786b; padding:0 14rpx; font-size:24rpx; }
.danger { color:#ad564e; }
input, textarea, .picker { box-sizing:border-box; background:#f5f6f2; border-radius:16rpx; width:100%; margin-top:12rpx; font-size:28rpx; }
input { display:block; height:96rpx; min-height:96rpx; padding:0 22rpx; line-height:normal; }
.picker { padding:22rpx; }
textarea { min-height:200rpx; padding:18rpx 22rpx; line-height:1.6; }
.label { display:block; font-size:24rpx; color:#67766b; margin-top:24rpx; }
.divider { height:1rpx; background:#edf0e9; margin:24rpx 0; }
.empty { text-align:center; padding:60rpx 24rpx; }
.empty-icon { font-size:64rpx; margin-bottom:20rpx; }
.tab-row { display:flex; gap:12rpx; flex-wrap:wrap; margin-top:22rpx; }
.chip { font-size:25rpx; padding:12rpx 26rpx; border-radius:32rpx; background:#eaece4; color:#738071; }
.chip.active { background:#27654c; color:white; }
.body { white-space:pre-wrap; font-size:29rpx; line-height:1.95; margin:22rpx 0; }
.task-title { font-size:32rpx; font-weight:500; margin-top:18rpx; }
.done-title { color:#7b877b; }
.meter { height:12rpx; border-radius:8rpx; background:rgba(255,255,255,.2); margin-top:24rpx; overflow:hidden; }
.meter-fill { height:100%; background:#dfebad; border-radius:8rpx; }
.big-number { font-size:64rpx; font-weight:600; }
.member { padding:20rpx 0; border-bottom:1rpx solid #f0f2ec; }
.invite { font-family:monospace; font-size:28rpx; overflow-wrap:anywhere; line-height:1.8; }
.subjects { gap:12rpx 8rpx; }
.subject-chip { font-size:24rpx; padding:10rpx 18rpx; color:#778077; border-radius:24rpx; background:#eeeee7; }
.subject-chip.selected { background:#e0ead9; color:#27654c; font-weight:600; }
.segmented { display:flex; padding:8rpx; border-radius:20rpx; background:#e9ece4; margin-top:30rpx; }
.segment { flex:1; padding:18rpx 8rpx; text-align:center; font-size:27rpx; color:#718071; border-radius:14rpx; }
.segment.selected { background:white; color:#27654c; font-weight:600; box-shadow:0 2rpx 8rpx rgba(37,59,50,.05); }
.rule-title { font-size:31rpx; font-weight:600; }
.mode-picker { background:#f0f4eb; border-radius:16rpx; padding:14rpx 24rpx; color:#46694c; font-size:26rpx; }
.stepper { display:flex; flex:0 0 216rpx; width:216rpx; align-items:center; border-radius:14rpx; background:#f4f5f0; }
button.step { flex:0 0 68rpx; min-width:0; background:transparent; font-size:30rpx; width:68rpx; padding:0; line-height:2; color:#27654c; }
input.quantity { flex:0 0 80rpx; width:80rpx; padding:0; margin:0; text-align:center; height:68rpx; min-height:68rpx; background:transparent; }
button.primary, button.secondary { width:100%; }
button.small, button.quiet { width:auto; flex-shrink:0; }
.plan-help { margin-top:24rpx; }
.quick-links { margin-top:24rpx; }
.stats-row { display:flex; justify-content:space-around; text-align:center; }
.stat-number { font-size:52rpx; font-weight:600; color:#27654c; }
.history-actions { margin-top:24rpx; }
.grow { flex:1; min-width:0; }
.math { background:#fcebcf; color:#906527; }
.reading { background:#f4e6ee; color:#96617d; }
button[disabled] { opacity:.5; }
.library-preview { margin-top:10rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.learning-card-actions { display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:12rpx; }
.learning-card-actions button { margin:0; min-height:88rpx; display:flex; align-items:center; justify-content:center; }
.pinyin-text { font-weight:400; font-size:32rpx; }
.pinyin-line { min-height:28rpx; line-height:1; }
.pinyin-unit {display:inline-flex;align-items:flex-end;margin:8rpx 0;vertical-align:bottom;}
.pinyin-token { display:inline-flex; flex-direction:column; align-items:center; justify-content:flex-end; min-width:1em; padding:0 4rpx; }
.pinyin-syllable { font-size:23rpx; color:#627568; height:34rpx; line-height:34rpx; white-space:nowrap; }
.pinyin-glyph { line-height:48rpx; white-space:pre; }
.pinyin-punctuation { padding:0; min-width:.65em; }
.pinyin-toggle { min-height:80rpx; margin-top:0; text-align:right; }
.study-notes { border-top:1rpx solid #edf0e9; margin-top:24rpx; padding-top:4rpx; }
.notes-toggle { min-height:88rpx; text-align:left; }
.notes-body { overflow-wrap:anywhere; }
button.notes-source { padding:16rpx 12rpx; text-align:left; }

/* Learning detail content and source disclosure */
.study-item .task-title { font-size:36rpx; font-weight:600; overflow-wrap:anywhere; }
.study-item .body { font-size:32rpx; line-height:2; overflow-wrap:anywhere; }
.study-note { background:#f5f6f2; border-radius:16rpx; padding:18rpx 22rpx; margin:18rpx 0; font-size:26rpx; white-space:pre-wrap; }
.study-source { border-top:1rpx solid #edf0e9; padding-top:18rpx; white-space:pre-wrap; overflow-wrap:anywhere; }
.content-sources { border-top:1rpx solid #edf0e9; margin-top:28rpx; padding-top:8rpx; }
.sources-toggle { width:100%; min-height:44px; text-align:left; }
.sources-body { white-space:pre-wrap; overflow-wrap:anywhere; padding-bottom:12rpx; }
.source-book { border-top:1rpx solid #edf0e9; padding-top:20rpx; margin-top:20rpx; }
.recitation-summary { color:#45644b; }

/* Planned task editing sheet */
.edit-mask { position:fixed; inset:0; z-index:100; display:flex; align-items:center; justify-content:center; background:rgba(24,39,30,.38); padding:24rpx; }
.edit-sheet { width:100%; max-width:680rpx; max-height:85vh; overflow-y:auto; border-radius:28rpx; padding:32rpx; background:#fff; }
.edit-delete { color:#a53d32; margin-top:20rpx; }
.edit-cancel { margin:24rpx auto 0; padding:12rpx 36rpx; }

/* Shared content date scheduling */
.schedule-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(24, 39, 30, .38); padding: 24rpx; }
.schedule-sheet { width: 100%; max-width: 680rpx; max-height: 85vh; overflow-y: auto; border-radius: 28rpx; padding: 32rpx; background: #fff; }
.schedule-shortcuts { display: flex; gap: 16rpx; margin-top: 28rpx; }
.schedule-shortcuts button { flex: 1; background: #edf2eb; color: #315e43; }
.schedule-shortcuts button.selected { background: #27654c; color: #fff; }
.schedule-cancel { margin: 24rpx auto 0; padding: 12rpx 36rpx; }
.schedule-sheet button, .schedule-sheet .picker { min-height:44px; }
