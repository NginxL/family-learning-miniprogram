<view wx:if="{{available}}" class="speech">
  <button class="speech-button" bindtap="toggleReading" loading="{{loading || confirming}}" disabled="{{confirming}}">{{loading ? '准备中 · 点击停止' : playing ? '■ 停止朗读' : '▶ 朗读'}}<text wx:if="{{(loading || playing) && parts > 1}}"> · {{part}}/{{parts}}</text></button>
  <view wx:if="{{error}}" class="speech-error">{{error}}</view>
  <view wx:if="{{notice && !error}}" class="speech-error">{{notice}}</view>
</view>
